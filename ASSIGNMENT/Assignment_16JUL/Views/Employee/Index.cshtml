@model List<Assignment_16JUL.Models.Employee>

<!DOCTYPE html>
<html>
<head>
    <title>Employee Management System</title>

    <style>
            table {
                width: 80%;
                border-collapse: collapse;
                margin: 20px auto;
            }

            th, td {
                border: 1px solid black;
                padding: 10px;
                text-align: center;
            }

            th {
                background-color: lightblue;
            }

            h1 {
                text-align: center;
            }
    </style>
</head>

<body>

    <h1>Employee Management System</h1>

    <table>
        <tr>
            <th>Employee ID</th>
            <th>Name</th>
            <th>Department</th>
            <th>Salary</th>
            <th>Email</th>
        </tr>

        @foreach (var employee in Model)
        {
            <tr>
                <td>@employee.EmployeeId</td>
                <td>@employee.Name</td>
                <td>@employee.Department</td>
                <td>@employee.Salary</td>
                <td>@employee.Email</td>
            </tr>
        }
    </table>

</body>
</html>